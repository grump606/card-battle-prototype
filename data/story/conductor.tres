[gd_resource type="Resource" script_class="StoryBeat" format=3]

[ext_resource type="Script" path="res://run/story_beat.gd" id="1_beat"]

[resource]
script = ExtResource("1_beat")
title = "The Conductor"
text = "A figure in a faded coat walks the aisle, punching holes in tickets that are not there. Under the peaked cap there is only bone and two red coals.

\"Next stop is yours,\" he says, without moving his mouth. \"They all are.\""
button_text = "Look away"

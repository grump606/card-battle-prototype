[gd_resource type="Resource" script_class="StoryBeat" format=3]

[ext_resource type="Script" path="res://run/story_beat.gd" id="1_beat"]

[resource]
script = ExtResource("1_beat")
title = "The Last Train"
text = "You wake on a bench of cold iron. Somewhere ahead, a whistle drags itself across the dark.

The doors are open. Nobody is checking tickets, and nobody is leaving. You step aboard before you can think better of it."
button_text = "Board"

[gd_resource type="Resource" script_class="StoryBeat" format=3]

[ext_resource type="Script" path="res://run/story_beat.gd" id="1_beat"]

[resource]
script = ExtResource("1_beat")
title = "The Silent Station"
text = "The train sighs to a halt at a platform lit by a single guttering lamp. Behind you the Brakeman's wheel winds down. Rows of shapes stand waiting, perfectly still.

They stand like men told to hold the line. You know that stillness. The Conductor is still ahead, and you do not look for the exit."
button_text = "Hold the line"

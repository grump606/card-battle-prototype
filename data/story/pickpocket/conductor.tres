[gd_resource type="Resource" script_class="StoryBeat" format=3]

[ext_resource type="Script" path="res://run/story_beat.gd" id="1_beat"]

[resource]
script = ExtResource("1_beat")
title = "The Conductor"
text = "A figure in a faded coat walks the aisle, punching holes in tickets that are not there. Where his face should be, the lamplight simply bends.

\"Quick fingers,\" he says, without moving his mouth. \"Everything on this train is already taken. Next stop is yours.\""
button_text = "Keep your hands still"

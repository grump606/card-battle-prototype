[gd_resource type="Resource" script_class="StoryBeat" format=3]

[ext_resource type="Script" path="res://run/story_beat.gd" id="1_beat"]

[resource]
script = ExtResource("1_beat")
title = "The Silent Station"
text = "The train sighs to a halt at a platform lit by a single guttering lamp. The Brakeman's last groan fades from the iron, and the voices behind your ribs go quiet. Rows of shapes stand waiting, perfectly still.

None of them whisper. They are listening for what you are: the Conductor's slow tread, somewhere up the line."
button_text = "Listen"

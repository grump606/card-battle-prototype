[gd_resource type="Resource" script_class="StoryBeat" format=3]

[ext_resource type="Script" path="res://run/story_beat.gd" id="1_beat"]

[resource]
script = ExtResource("1_beat")
title = "The Last Train"
text = "You wake on a bench of cold iron, and the quiet is wrong. Your whole life there was a murmur behind it. Somewhere ahead, a whistle drags itself across the dark.

The doors are open. The dead are not whispering. They are all aboard, and they are waiting for you."
button_text = "Board"

[resource]
script = ExtResource("1_char")
id = &"pickpocket"
display_name = "The Pickpocket"
pitch = "Lifted one purse too many. Quick and fragile, cycles cards and punishes marked targets."
max_hp = 44
starting_deck = Array[ExtResource("2_card")]([ExtResource("3_shove"), ExtResource("3_shove"), ExtResource("3_shove"), ExtResource("4_slip_past"), ExtResource("4_slip_past"), ExtResource("5_glimpse_exit"), ExtResource("6_mark_the_weak"), ExtResource("7_cutting_word"), ExtResource("8_second_wind"), ExtResource("9_hamstring")])
